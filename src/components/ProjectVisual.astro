---
interface Props { kind: 'credit' | 'classification' | 'forecast' | 'tableau' | 'relational' | 'none'; large?: boolean; }
const { kind, large = false } = Astro.props;
const labels = {
  credit: 'Application data and credit histories become financial features, compared through logistic regression and LightGBM to estimate repayment risk',
  classification: 'A schematic decision tree, representing a classification workflow',
  forecast: 'A schematic time series with a held-out period, representing temporal validation',
  tableau: 'An empty plotting frame for a future Tableau visualization',
  relational: 'Report records linked by their identifier to people, vehicles, streets, and coordinates',
  none: 'An empty plotting frame; project preview not yet provided',
};
const visualTitles = {
  credit: 'Credit risk',
  classification: 'Classification',
  forecast: 'Time series',
  tableau: 'Visualization',
  relational: 'Relational model',
  none: 'Project preview',
};
---
<figure class:list={['project-visual', `visual-${kind}`, { 'visual-large': large }]}>
  <div class="visual-label" aria-hidden="true"><span>{visualTitles[kind]}</span><span>LB</span></div>
  <svg viewBox="0 0 440 240" fill="none" role="img" aria-label={labels[kind]}>
    {kind === 'credit' ? <>
      <path d="M84 62v16h272V62M220 62v31M220 123v16H119v16m101-16h101v16M119 185v17h202v-17M220 202v14" stroke="var(--color-copper)" stroke-width="1.2" />
      {[[84, 'application'], [220, 'bureau'], [356, 'previous_app']].map(([x, label]) => <>
        <rect x={Number(x) - 55} y="32" width="110" height="30" fill="var(--color-surface)" stroke="var(--color-border)" />
        <text x={x} y="51" text-anchor="middle" fill="currentColor">{label}</text>
      </>)}
      <rect x="136" y="93" width="168" height="30" fill="var(--color-ink)" />
      <text x="220" y="112" text-anchor="middle" fill="var(--color-paper)">financial features</text>
      {[[119, 'Logistic regression'], [321, 'LightGBM']].map(([x, label]) => <>
        <rect x={Number(x) - 75} y="155" width="150" height="30" fill="var(--color-surface)" stroke="var(--color-border)" />
        <text x={x} y="174" text-anchor="middle" fill="currentColor">{label}</text>
      </>)}
      <text x="220" y="232" text-anchor="middle" fill="var(--color-accent)">repayment-risk estimates</text>
    </> : kind === 'classification' ? <>
      <path d="M220 58v32H112v40m108-40h108v40M112 154v24H59v28m53-28h53v28m163-52v24h-53v28m53-28h53v28" stroke="currentColor" stroke-width="1" />
      <rect x="177" y="26" width="86" height="32" fill="var(--color-ink)" />
      <rect x="76" y="130" width="72" height="25" stroke="currentColor" />
      <rect x="292" y="130" width="72" height="25" stroke="currentColor" />
      <text x="220" y="47" fill="var(--color-paper)" text-anchor="middle">churn?</text>
      <text x="112" y="147" fill="currentColor" text-anchor="middle">split A</text>
      <text x="328" y="147" fill="currentColor" text-anchor="middle">split B</text>
      {[59, 165, 275, 381].map((x, i) => <circle cx={x} cy="211" r="5" fill={i === 0 || i === 3 ? 'var(--color-copper)' : 'var(--color-paper)'} stroke={i === 0 || i === 3 ? 'var(--color-copper)' : 'currentColor'} />)}
      <text x="128" y="110" fill="var(--color-muted)">yes</text><text x="286" y="110" fill="var(--color-muted)">no</text>
    </> : kind === 'forecast' ? <>
      <path d="M28 202h386M28 35v167" stroke="currentColor" stroke-opacity=".3" />
      {[65, 110, 155].map(y => <path d={`M28 ${y}h386`} stroke="currentColor" stroke-opacity=".12" stroke-dasharray="2 4" />)}
      <path d="M284 35v167" stroke="var(--color-copper)" stroke-dasharray="3 5" />
      <path d="m28 173 17-9 17 6 17-37 17 14 17-22 17 15 17-48 17 26 17-7 17 16 17-40 17 10 17-24 17 18 18-28" stroke="currentColor" stroke-width="1.5" />
      <path d="m284 72 20 8 20-22 20 10 20-28 20 12 30-17" stroke="var(--color-copper)" stroke-width="1.5" stroke-dasharray="4 4" />
      <text x="28" y="226" fill="currentColor">historical window</text><text x="295" y="226" fill="var(--color-accent)">holdout</text>
    </> : kind === 'relational' ? <>
      <path d="M220 100V55H92m128 0h128M220 140v48H92m128 0h128" stroke="var(--color-copper)" stroke-width="1.2" />
      <rect x="162" y="100" width="116" height="40" fill="var(--color-ink)" />
      <text x="220" y="125" fill="var(--color-paper)" text-anchor="middle">reports</text>
      {[[92, 55, 'people'], [348, 55, 'vehicles'], [92, 188, 'streets'], [348, 188, 'coordinates']].map(([x, y, label]) => <>
        <rect x={Number(x) - 54} y={Number(y) - 17} width="108" height="34" fill="var(--color-surface)" stroke="var(--color-border)" />
        <text x={x} y={Number(y) + 5} text-anchor="middle" fill="currentColor">{label}</text>
      </>)}
    </> : <>
      <path d="M55 28v170h334M55 70h334M55 113h334M55 156h334M139 28v170M222 28v170M306 28v170M389 28v170" stroke="currentColor" stroke-opacity=".16" />
      <rect x="115" y="84" width="214" height="51" fill="var(--color-paper)" />
      <text x="222" y="106" text-anchor="middle" fill="currentColor">{kind === 'tableau' ? 'A view, forthcoming.' : 'Preview forthcoming.'}</text>
      <text x="222" y="126" text-anchor="middle" fill="var(--color-muted)" font-size="9">{kind === 'tableau' ? 'TABLEAU PUBLIC' : 'PROJECT PREVIEW'}</text>
      <text x="55" y="226" fill="var(--color-muted)">No data published</text>
    </>}
  </svg>
  <figcaption>{kind === 'credit' ? 'Method schematic · from applications to risk estimates' : kind === 'relational' ? 'Model diagram · based on workbook relationships' : kind === 'classification' || kind === 'forecast' ? 'Method illustration · not an experimental result' : 'Placeholder · visualization not yet provided'}</figcaption>
</figure>
