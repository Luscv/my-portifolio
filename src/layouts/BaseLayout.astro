---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/site';
import { withBase } from '../lib/paths';
interface Props { title?: string; description?: string; article?: boolean; noindex?: boolean; canonicalPath?: string; }
const { title, description = profile.description, article = false, noindex = false, canonicalPath } = Astro.props;
const pageTitle = title ? `${title} — ${profile.name}` : `${profile.name} — Data Scientist`;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase('og-image.png'), Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F3F0E8" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Lucas Barros" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lucas Barros — Data Science, Statistical Modeling & Applied Research" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
