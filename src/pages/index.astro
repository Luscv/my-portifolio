---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SignalStudy from '../components/SignalStudy.astro';
import Arrow from '../components/Arrow.astro';
import Asterisk from '../components/Asterisk.astro';
import FieldnotesSection from '../components/FieldnotesSection.astro';
import ProfilePortrait from '../components/ProfilePortrait.astro';
import { profile } from '../data/site';
const projects = (await getCollection('projects', ({ data }) => data.featured)).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-topline"><p class="eyebrow"><span class="small-star" aria-hidden="true"><Asterisk /></span> Data science & applied research</p><p class="mono hero-note">A portfolio by Lucas Barros</p></div>
    <div class="hero-grid">
      <div class="hero-title-block"><h1 id="hero-title">Finding structure<br />in the <em>uncertain.</em></h1><p class="hero-description">I’m Lucas, a Data Scientist focused on applied statistics. I use statistical thinking and machine learning to turn complex problems into considered work.</p><a class="text-link hero-link" href="#work">Explore selected work<span aria-hidden="true">↓</span></a></div>
      <SignalStudy />
    </div>
    <div class="hero-bottom mono"><span>Statistical modeling</span><span>Machine learning</span><span>Forecasting</span><span>Applied research</span></div>
  </section>
  <section class="work-section container" id="work" aria-labelledby="work-title">
    <div class="section-heading"><div><p class="eyebrow">01 / The practice</p><h2 id="work-title">Selected work<span class="section-count mono">({String(projects.length).padStart(2, '0')})</span></h2></div><p>Problems, methods, and the<br class="desktop-break" /> thinking in between.</p></div>
    <div class="project-list">{projects.map((project, index) => <ProjectRow project={project} index={index} />)}</div>
  </section>
  <section class="about-section container" id="about" aria-labelledby="about-title">
    <div class="about-label"><p class="eyebrow">02 / Behind the work</p><ProfilePortrait /></div>
    <div class="about-content"><h2 id="about-title">Data science.<br /><em>An art of statistical thinking.</em></h2><div class="about-body"><p>My focus is Data Science. I’m interested in what happens when scientific methodology meets the creative art of statistical reasoning.</p><p>I hold a postgraduate degree in <strong>Statistics for AI and Data Science at PUC Minas</strong>, with an interest in applied research and reproducible machine learning.</p><p>This portfolio brings together documented projects, work in progress, and the questions that guide them.</p></div><a class="text-link" href={profile.github}>Find me on GitHub<Arrow diagonal /></a><dl class="about-details"><div><dt>Focus</dt><dd>Data Science & Applied Statistics</dd></div><div><dt>Specialization</dt><dd>Specializing in credit risk<br /><span>Modeling & risk management</span></dd></div><div><dt>Interests</dt><dd>Applied research<br />Reproducible ML</dd></div></dl></div>
  </section>
  <FieldnotesSection />
</BaseLayout>
