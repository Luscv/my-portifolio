{
  "name": "lucas-barros-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev",
    "start": "node scripts/astro.mjs dev",
    "check": "node scripts/astro.mjs check",
    "build": "node scripts/astro.mjs check && node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview",
    "test": "node --test tests/*.test.mjs",
    "validate": "npm run test && npm run build && node scripts/check-build.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "astro": "7.4.0",
    "katex": "^0.19.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3"
  },
  "overrides": { "katex": "$katex" }
}
